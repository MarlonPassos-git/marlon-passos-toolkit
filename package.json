{
	"name": "m-p-toolkit",
	"private": true,
	"scripts": {
		"build": "pnpm -r --if-present build",
		"check": "pnpm -r check",
		"changeset": "changeset",
		"changeset:publish": "changeset publish",
		"changeset:version": "changeset version",
		"dev": "pnpm -r --if-present dev",
		"lint": "pnpm -r --if-present lint",
		"lint:fix": "pnpm -r --if-present lint:fix",
		"test": "pnpm -r --if-present test",
		"test:biome-plugin": "node --test --test-reporter=spec packages/biome-config/plugins/__tests__/prefer-direct-filter-callback.unit.spec.ts",
		"type-check": "pnpm -r --if-present type-check"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@biomejs/biome": "2.5.4",
		"@changesets/cli": "^2.31.0",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@11.11.0",
	"engines": {
		"node": ">=18"
	}
}
