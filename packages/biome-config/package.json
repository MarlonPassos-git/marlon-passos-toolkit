{
  "name": "@m-p-toolkit/biome-config",
  "version": "1.0.0",
  "description": "Personal Biome configuration from Marlon Passos",
  "keywords": [
    "biome",
    "biome-config",
    "formatter",
    "linter"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./base.json",
    "./base": "./base.json",
    "./node": "./node.json",
    "./react": "./react.json",
    "./svelte": "./svelte.json",
    "./base.json": "./base.json",
    "./node.json": "./node.json",
    "./react.json": "./react.json",
    "./svelte.json": "./svelte.json",
    "./plugins/prefer-direct-filter-callback.warn.grit": "./plugins/prefer-direct-filter-callback.warn.grit",
    "./plugins/prefer-direct-filter-callback.error.grit": "./plugins/prefer-direct-filter-callback.error.grit"
  },
  "files": [
    "base.json",
    "node.json",
    "react.json",
    "svelte.json",
    "docs",
    "plugins/*.grit",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "biome check --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test --test-reporter=spec plugins/__tests__/prefer-direct-filter-callback.unit.spec.ts",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.4.0"
  },
  "repository": {
    "directory": "packages/biome-config",
    "type": "git",
    "url": "git+https://github.com/MarlonPassos-git/marlon-passos-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/MarlonPassos-git/marlon-passos-toolkit/issues"
  },
  "homepage": "https://github.com/MarlonPassos-git/marlon-passos-toolkit/tree/main/packages/biome-config#readme"
}
