{
  "$schema": "https://biomejs.dev/schemas/2.3.15/schema.json",
  "extends": ["./base.json"],
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noNodejsModules": "off"
      },
      "style": {
        "noDefaultExport": "warn",
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
